# Copie este arquivo para .env e preencha com os seus dados:
#   cp .env.example .env
# O arquivo .env está no .gitignore e NUNCA deve ser versionado.

# ---------------- Servidor SMTP ----------------
# Gmail:    smtp.gmail.com     | porta 587 | starttls  (exige senha de app)
# Outlook:  smtp.office365.com | porta 587 | starttls
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
# starttls (porta 587), ssl (porta 465) ou nenhuma (apenas servidores locais de teste)
SMTP_SEGURANCA=starttls
SMTP_USUARIO=seu.email@gmail.com
# Gmail: cole a senha de app de 16 caracteres, sem espaços. Nunca use a senha principal da conta.
SMTP_SENHA=
SMTP_TIMEOUT=30

# ---------------- Remetente ----------------
# Se vazio, usa SMTP_USUARIO.
EMAIL_REMETENTE=seu.email@gmail.com
EMAIL_NOME_REMETENTE=Seu Nome

# ---------------- Ritmo e resiliência ----------------
# Intervalo mínimo entre envios (segundos)
ENVIO_INTERVALO_SEGUNDOS=1.0
# Tentativas por mensagem em falhas temporárias (conexão, códigos 4xx)
ENVIO_MAX_TENTATIVAS=3
# Espera inicial entre tentativas; dobra a cada nova tentativa (2s, 4s, 8s...)
ENVIO_BACKOFF_SEGUNDOS=2.0
